{
  "service": "Come-down(캄다운)",
  "version": "1.0",
  "basis": ["서비스_요구사항.md", "API.md", "ERD.md", "IA_초안.png"],
  "packageProposal": "com.comedown",
  "tableOwners": {
    "users": "account", "user_consents": "account", "user_settings": "account",
    "user_preferred_activities": "account", "oauth_tokens": "account",
    "subscriptions": "subscription", "cbi_assessments": "cbi", "cbi_answers": "cbi",
    "calendar_events": "calendar", "event_category_overrides": "calendar",
    "weekly_loads": "schedule", "morning_checks": "checkin", "hrv_measurements": "checkin",
    "hrv_daily_states": "recovery", "suggestions": "recommendation", "ai_outputs": "ai",
    "safety_alerts": "safety", "api_idempotency_keys": "shared.idempotency"
  },
  "httpOwners": {
    "GET /api/auth/csrf": "shared.security",
    "GET /api/me": "account.api",
    "POST /api/auth/logout": "shared.security",
    "DELETE /api/me": "experience.accountlifecycle",
    "PUT /api/onboarding/profile": "experience.onboarding",
    "GET /api/cbi/questions": "cbi.api",
    "POST /api/cbi/assessments": "experience.assessments",
    "GET /api/cbi/assessments": "cbi.api",
    "PUT /api/me/settings": "experience.onboarding",
    "GET /api/schedule/report": "experience.reports",
    "POST /api/onboarding/complete": "experience.onboarding",
    "GET /api/home": "experience.home",
    "POST /api/calendar/sync": "experience.calendarflow",
    "GET /api/calendar/events": "calendar.api",
    "PATCH /api/calendar/events/{id}/category": "experience.calendarflow",
    "GET /api/schedule/weeks": "schedule.api",
    "DELETE /api/calendar/connection": "experience.accountlifecycle",
    "GET /api/suggestions": "recommendation.api",
    "POST /api/suggestions/generate": "experience.suggestions",
    "GET /api/suggestions/{id}/slots": "experience.suggestions",
    "POST /api/suggestions/{id}/approve": "experience.suggestions",
    "POST /api/suggestions/{id}/dismiss": "recommendation.api",
    "POST /api/suggestions/{id}/undo": "experience.suggestions",
    "POST /api/suggestions/{id}/done": "recommendation.api",
    "GET /api/morning-checks/today": "experience.morning",
    "POST /api/hrv/measurements": "experience.morning",
    "POST /api/morning-checks/today/breathing": "checkin.api",
    "PUT /api/morning-checks/today/condition": "experience.morning",
    "GET /api/reports/recovery": "experience.reports",
    "GET /api/reports/four-week": "experience.reports",
    "PATCH /api/me": "account.api",
    "GET /api/me/settings": "account.api",
    "GET /api/me/consents": "account.api",
    "POST /api/me/consents": "account.api",
    "DELETE /api/me/consents/SENSITIVE_HRV": "experience.accountlifecycle",
    "DELETE /api/hrv/data": "experience.accountlifecycle",
    "GET /api/safety": "safety.api",
    "POST /api/safety/alerts/{id}/acknowledge": "safety.api",
    "POST /api/onboarding/cbi/skip": "experience.onboarding"
  },
  "additionalRoutes": {
    "GET /oauth2/authorization/google": "shared.security + account + integration.google",
    "GET /oauth2/authorization/google-calendar": "shared.security + account + integration.google",
    "GET /login/oauth2/code/{registrationId}": "shared.security + account + integration.google",
    "POST /api/dev/login": "local 전용 개발 지원; shared.security 테스트 로그인(세션만 생성, 사용자 행은 만들지 않음)",
    "POST /api/dev/seed": "local 전용 개발 지원; 기능별 contract로 시드 입력",
    "POST /api/dev/clock": "local 전용 개발 지원; shared.time의 테스트 시계 경계",
    "DELETE /api/dev/data": "local 전용 개발 지원; experience.accountlifecycle의 정리 계약 사용"
  }
}
